{
    "name": "Clinical Terminology Mapper",
    "description": "Harmonizes REDCap fields with standardized clinical ontologies (HL7 FHIR R4/R5, US Core, mCODE, SDOH, RxNorm, and LOINC). Validates multiple-choice options, prevents EHR/CDIS adjudication errors, and standardizes custom project fields.",
    "namespace": "UWMadison\\ClinicalTerminologyMapper",
    "authors": [
        {
            "name": "Adam Nunez",
            "email": "Adam.Nunez@ctri.wisc.edu",
            "institution": "UW Madison - Center for Tobacco Research and Intervention"
        }
    ],
    "framework-version": 17,
    "auth-ajax-actions": [
        "get_mapped_fields",
        "get_project_fields",
        "add_custom_field",
        "remove_custom_field",
        "search_valuesets",
        "get_valueset_options",
        "apply_choices",
        "batch_apply_choices",
        "parse_fhir_payload",
        "detect_from_cached_cdp",
        "set_field_valueset_override",
        "build_terminology",
        "expand_valueset",
        "get_remote_valueset_total",
        "sync_loinc",
        "purge_loinc"
    ],
    "links": {
        "control-center": [
            {
                "name": "Clinical Terminology DB Manager",
                "icon": "fas fa-database",
                "url": "manager.php",
                "show-header-and-footer": true
            }
        ],
        "project": [
            {
                "name": "Clinical Terminology Mapper",
                "icon": "fas fa-sync-alt",
                "url": "index.php",
                "show-header-and-footer": true
            }
        ]
    },
    "system-settings": [
        {
            "key": "system_terminology_heading",
            "name": "<h4 style='margin-bottom:4px; color:#1e3a8a;'><i class='fas fa-database'></i> Clinical Terminology Database</h4><p style='color:#64748b; font-size:0.85rem; margin-bottom:8px;'>The Terminology Database powers FHIR, US Core, mCODE, SDOH, RxNorm, and LOINC ValueSet search and auto-matching across all projects. You can check the current database status, build, or update the database from the <a href='../ExternalModules/?prefix=clinical_terminology_mapper&page=manager' style='font-weight:600;' target='_blank'>Clinical Terminology DB Manager</a> in the Control Center menu.</p>",
            "type": "descriptive"
        }
    ],
